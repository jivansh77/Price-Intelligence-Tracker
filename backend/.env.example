# Server
PORT=5000

# CORS – comma-separated list of allowed origins
# Example: https://d1234abcdef.cloudfront.net,http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# AWS DynamoDB
AWS_REGION=us-east-1
DYNAMODB_TABLE=PricingHistory

# AWS credentials (set these on EC2 via IAM Role instead of hardcoding)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
